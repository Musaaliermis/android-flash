class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContent {
            MyApplicationTheme {
                FlashlightScreen()
            }
        }
    }
}

@Composable
fun FlashlightScreen() {
    val context = LocalContext.current
    val currentMode by FlashlightController.currentMode.collectAsState()
    val speedFactor by FlashlightController.speedFactor.collectAsState()
    val isRunning by FlashlightController.isServiceRunning.collectAsState()

    var showPermissionRationale by remember { mutableStateOf(false) }

    val requiredPermissions = remember {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            arrayOf(Manifest.permission.CAMERA, Manifest.permission.POST_NOTIFICATIONS)
        } else {
            arrayOf(Manifest.permission.CAMERA)
        }
    }

    val permissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) { grants ->
        val cameraGranted = grants[Manifest.permission.CAMERA] == true
        if (!cameraGranted) {
            showPermissionRationale = true
        }
    }

    fun hasPermissions(): Boolean {
        return requiredPermissions.all { perm ->
            ContextCompat.checkSelfPermission(context, perm) == PackageManager.PERMISSION_GRANTED
        }
    }

    fun handleModeClick(targetMode: FlashlightMode) {
        if (!hasPermissions()) {
            permissionLauncher.launch(requiredPermissions)
            return
        }
        if (currentMode == targetMode) {
            FlashlightController.stopMode(context)
        } else {
            FlashlightController.startMode(context, targetMode)
        }
    }

    val bgDark = Color(0xFF0A0C10)
    val cardDark = Color(0xFF161B22)
    val emerald = Color(0xFF34D399)
    val red = Color(0xFFEF4444)
    val slateText = Color(0xFFF1F5F9)
    val slateMuted = Color(0xFF94A3B8)
    val slateDim = Color(0xFF64748B)

    // Animations
    val infiniteTransition = rememberInfiniteTransition(label = "pulse")
    val pulseAlpha by infiniteTransition.animateFloat(
        initialValue = 0.3f, targetValue = 1f,
        animationSpec = infiniteRepeatable(tween(800, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "pulseAlpha"
    )

    val centerBtnColor by animateColorAsState(
        targetValue = when (currentMode) {
            FlashlightMode.NORMAL -> emerald
            FlashlightMode.SOLID -> emerald
            FlashlightMode.SOS -> red
            FlashlightMode.OFF -> Color(0xFF1E293B)
        }, label = "btnColor"
    )

    Scaffold(
        modifier = Modifier.fillMaxSize(),
        containerColor = bgDark
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .statusBarsPadding(),
            verticalArrangement = Arrangement.SpaceBetween
        ) {
            // Top Header
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 24.dp, vertical = 16.dp)
            ) {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text(
                        text = "Torch Control",
                        color = slateText,
                        fontSize = 26.sp,
                        fontWeight = FontWeight.SemiBold
                    )
                    Box(
                        modifier = Modifier
                            .clip(RoundedCornerShape(6.dp))
                            .background(red.copy(alpha = 0.1f))
                            .border(1.dp, red.copy(alpha = 0.3f), RoundedCornerShape(6.dp))
                            .padding(horizontal = 8.dp, vertical = 4.dp)
                    ) {
                        Text(
                            text = "EMERGENCY READY",
                            color = red,
                            fontSize = 10.sp,
                            fontWeight = FontWeight.Bold,
                            letterSpacing = 1.5.sp
                        )
                    }
                }
                Spacer(modifier = Modifier.height(6.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Text(text = "Status: ", color = slateDim, fontSize = 14.sp)
                    val statusText = when (currentMode) {
                        FlashlightMode.OFF -> "Off"
                        FlashlightMode.NORMAL -> "Normal Flashing Mode"
                        FlashlightMode.SOS -> "SOS Emergency Signal"
                        FlashlightMode.SOLID -> "Solid Continuous Torch"
                    }
                    val statusColor = when (currentMode) {
                        FlashlightMode.OFF -> slateMuted
                        FlashlightMode.SOS -> red
                        else -> emerald
                    }
                    Text(
                        text = statusText,
                        color = statusColor,
                        fontSize = 14.sp,
                        fontWeight = FontWeight.Medium,
                        fontStyle = FontStyle.Italic
                    )
                }
            }

            // Middle Glowing Torch Area
            Box(
                modifier = Modifier
                    .weight(1f)
                    .fillMaxWidth(),
                contentAlignment = Alignment.Center
            ) {
                if (currentMode != FlashlightMode.OFF) {
                    Box(
                        modifier = Modifier
                            .size(260.dp)
                            .blur(50.dp)
                            .background(
                                color = if (currentMode == FlashlightMode.SOS) red.copy(alpha = 0.25f)
                                else emerald.copy(alpha = 0.25f),
                                shape = CircleShape
                            )
                    )
                }

                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.Center
                ) {
                    Box(
                        modifier = Modifier
                            .size(190.dp)
                            .clip(CircleShape)
                            .background(centerBtnColor)
                            .clickable { handleModeClick(FlashlightMode.NORMAL) },
                        contentAlignment = Alignment.Center
                    ) {
                        Icon(
                            imageVector = Icons.Default.PlayArrow,
                            contentDescription = "Power Normal Flashing",
                            tint = if (currentMode == FlashlightMode.OFF) slateDim else Color(0xFF0A0C10),
                            modifier = Modifier.size(80.dp)
                        )
                    }

                    Spacer(modifier = Modifier.height(24.dp))
                    Text(
                        text = if (currentMode == FlashlightMode.OFF) "OFF" else "ON",
                        color = if (currentMode == FlashlightMode.OFF) slateDim else slateText,
                        fontSize = 36.sp,
                        fontWeight = FontWeight.Light,
                        letterSpacing = 2.sp
                    )
                    Spacer(modifier = Modifier.height(4.dp))
                    Text(
                        text = when (currentMode) {
                            FlashlightMode.NORMAL -> "NORMAL STROBE ACTIVE"
                            FlashlightMode.SOLID -> "CONTINUOUS TORCH ACTIVE"
                            FlashlightMode.SOS -> "MORSE SOS ACTIVE"
                            FlashlightMode.OFF -> "TAP BUTTON FOR NORMAL FLASH"
                        },
                        color = slateDim,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold,
                        letterSpacing = 2.sp
                    )
                }
            }

            // Bottom Control Dashboard
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .clip(RoundedCornerShape(topStart = 40.dp, topEnd = 40.dp))
                    .background(cardDark)
                    .border(1.dp, Color.White.copy(alpha = 0.05f), RoundedCornerShape(topStart = 40.dp, topEnd = 40.dp))
                    .padding(horizontal = 28.dp, vertical = 28.dp)
                    .navigationBarsPadding()
            ) {
                // Strobe Frequency Slider
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.Bottom
                ) {
                    Text(
                        text = "STROBE FREQUENCY",
                        color = slateMuted,
                        fontSize = 12.sp,
                        fontWeight = FontWeight.Bold,
                        letterSpacing = 1.5.sp
                    )
                    Text(
                        text = "${String.format("%.1f", speedFactor)}x Speed",
                        color = emerald,
                        fontFamily = FontFamily.Monospace,
                        fontSize = 14.sp,
                        fontWeight = FontWeight.SemiBold
                    )
                }

                Spacer(modifier = Modifier.height(8.dp))

                Slider(
                    value = speedFactor,
                    onValueChange = { FlashlightController.speedFactor.value = it },
                    valueRange = 0.5f..2.0f,
                    colors = SliderDefaults.colors(
                        thumbColor = Color.White,
                        activeTrackColor = emerald,
                        inactiveTrackColor = Color(0xFF1E293B)
                    )
                )

                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 4.dp),
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Text("0.5x (Rapid)", color = slateDim, fontSize = 10.sp)
                    Text("2.0x (Slow)", color = slateDim, fontSize = 10.sp)
                }

                Spacer(modifier = Modifier.height(24.dp))

                // SOS Button & Solid Torch Button
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    // SOS Button
                    Box(
                        modifier = Modifier
                            .weight(1f)
                            .height(64.dp)
                            .clip(RoundedCornerShape(16.dp))
                            .background(if (currentMode == FlashlightMode.SOS) red.copy(alpha = 0.2f) else red.copy(alpha = 0.05f))
                            .border(2.dp, red.copy(alpha = if (currentMode == FlashlightMode.SOS) 0.8f else 0.3f), RoundedCornerShape(16.dp))
                            .clickable { handleModeClick(FlashlightMode.SOS) }
                            .padding(horizontal = 16.dp),
                        contentAlignment = Alignment.Center
                    ) {
                        Row(
                            verticalAlignment = Alignment.CenterVertically,
                            horizontalArrangement = Arrangement.Center
                        ) {
                            Box(
                                modifier = Modifier
                                    .size(10.dp)
                                    .clip(CircleShape)
                                    .background(red.copy(alpha = if (currentMode == FlashlightMode.SOS) pulseAlpha else 1f))
                            )
                            Spacer(modifier = Modifier.width(10.dp))
                            Text(
                                text = if (currentMode == FlashlightMode.SOS) "STOP SOS" else "SOS MODE",
                                color = red,
                                fontWeight = FontWeight.Bold,
                                fontSize = 14.sp,
                                letterSpacing = 2.sp
                            )
                        }
                    }

                    // Solid Torch Button
                    Box(
                        modifier = Modifier
                            .size(64.dp)
                            .clip(RoundedCornerShape(16.dp))
                            .background(if (currentMode == FlashlightMode.SOLID) emerald.copy(alpha = 0.2f) else Color(0xFF1E293B))
                            .border(1.dp, if (currentMode == FlashlightMode.SOLID) emerald else Color.Transparent, RoundedCornerShape(16.dp))
                            .clickable { handleModeClick(FlashlightMode.SOLID) },
                        contentAlignment = Alignment.Center
                    ) {
                        Icon(
                            imageVector = Icons.Default.Star,
                            contentDescription = "Solid Torch",
                            tint = if (currentMode == FlashlightMode.SOLID) emerald else slateMuted,
                            modifier = Modifier.size(28.dp)
                        )
                    }
                }

                Spacer(modifier = Modifier.height(20.dp))

                // Persistence Indicator
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .clip(RoundedCornerShape(12.dp))
                        .background(bgDark)
                        .padding(horizontal = 16.dp, vertical = 12.dp),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Column {
                        Text(
                            text = "FOREGROUND SERVICE",
                            color = slateDim,
                            fontSize = 10.sp,
                            fontWeight = FontWeight.Bold,
                            letterSpacing = 1.sp
                        )
                        Text(
                            text = if (isRunning) "Active (Background & Lock safe)" else "Standby",
                            color = if (isRunning) slateText else slateDim,
                            fontSize = 12.sp
                        )
                    }
                    Box(
                        modifier = Modifier
                            .size(width = 36.dp, height = 20.dp)
                            .clip(RoundedCornerShape(10.dp))
                            .background(if (isRunning) emerald.copy(alpha = 0.2f) else Color(0xFF1E293B))
                            .border(1.dp, if (isRunning) emerald.copy(alpha = 0.5f) else Color.Transparent, RoundedCornerShape(10.dp)),
                        contentAlignment = if (isRunning) Alignment.CenterEnd else Alignment.CenterStart
                    ) {
                        Box(
                            modifier = Modifier
                                .padding(2.dp)
                                .size(14.dp)
                                .clip(CircleShape)
                                .background(if (isRunning) emerald else slateDim)
                        )
                    }
                }
            }
        }

        if (showPermissionRationale) {
            AlertDialog(
                onDismissRequest = { showPermissionRationale = false },
                containerColor = cardDark,
                titleContentColor = slateText,
                textContentColor = slateMuted,
                icon = { Icon(Icons.Default.Warning, contentDescription = null, tint = red) },
                title = { Text("Permission Required") },
                text = {
                    Text("Flashlight control requires Camera permission to access the device LED torch. Please grant permission to use the flashlight.")
                },
                confirmButton = {
                    TextButton(onClick = {
                        showPermissionRationale = false
                        permissionLauncher.launch(requiredPermissions)
                    }) {
                        Text("Grant Permission", color = emerald)
                    }
                },
                dismissButton = {
                    TextButton(onClick = 
